# Front (Vercel). Copie para .env.local. Nunca versione valores reais.
# Endereço da API (repositório menzu-api). No computador: http://localhost:3004
MENZU_API_ORIGIN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público deste front.
NEXT_PUBLIC_APP_URL=

# Segredos usados pelo painel, no servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Mínimo de 32 caracteres.
MENZU_SESSION_SECRET=
# 64 caracteres hexadecimais; as MESMAS da API.
MENZU_CPF_ENCRYPTION_KEY=
ASAAS_ENCRYPTION_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_PLATFORM_WALLET_ID=
ASAAS_WEBHOOK_TOKEN=

# Vazio: só pagamento presencial. "asaas": Pix e cartão. Igual na API.
MENZU_ONLINE_PROVIDER=
MENZU_GEOCODING_ENABLED=true
